{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "## 🤖 FinOps — AI Agent Tokenomics (LIVE hub prices)\nAgent-level token cost from **gen_ai** OpenTelemetry traces (Microsoft Foundry / Agent Framework), priced with the **live FinOps Hub price data** (`Ingestion.Prices_final_v1_2`, the table behind `Prices()`) via the `adx()` cross-service proxy — no hard-coded rate card. Rates auto-update from the hub and cover every ingested model; models with no matching meter price as $0. Companion to the static-rate **AI Agent Tokenomics** workbook."
      },
      "name": "title"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let rc =\n    adx('https://ftkbjccus069d59.centralus.kusto.windows.net/Ingestion').Prices_final_v1_2\n    | where x_SkuMeterCategory == 'Foundry Models' and SkuMeter has 'Tokens'\n    | where SkuMeter !has 'Batch' and SkuMeter !has 'ft' and SkuMeter !has 'training' and SkuMeter !has 'aud' and SkuMeter !has 'rt' and SkuMeter !has 'transcribe' and SkuMeter !has 'tts'\n    | extend P = coalesce(x_EffectiveUnitPrice, ContractedUnitPrice, ListUnitPrice) * 1000000.0 / x_PricingBlockSize\n    | extend Direction = case(SkuMeter has_any('cached','cchd'),'Cached', SkuMeter has_any('outp','output'),'Output', SkuMeter has_any('inp','input','inpt'),'Input','Other')\n    | where Direction != 'Other'\n    | extend ModelKey = tolower(replace_regex(replace_regex(SkuMeter, @'(?i)[\\s\\-]+(cached|cchd|batch|inp|input|inpt|outp|output|glbl|regnl|tokens|dev).*$',''), @'[\\s\\.\\-_]',''))\n    | summarize InPer1M=maxif(P,Direction=='Input'), CachePer1M=maxif(P,Direction=='Cached'), OutPer1M=maxif(P,Direction=='Output') by ModelKey;\ndependencies\n| where timestamp > ago(30d)\n| extend d = parse_json(customDimensions)\n| where isnotempty(d[\"gen_ai.usage.input_tokens\"]) or isnotempty(d[\"gen_ai.usage.output_tokens\"])\n| extend AgentName = tostring(coalesce(d[\"microsoft.gen_ai.main_agent.name\"], d[\"gen_ai.agent.name\"])),\n         AgentId   = tostring(coalesce(d[\"microsoft.gen_ai.main_agent.id\"], d[\"gen_ai.agent.id\"])),\n         SessionId = tostring(coalesce(d[\"microsoft.gen_ai.main_agent.conversation_id\"], d[\"microsoft.session.id\"], d[\"gen_ai.conversation.id\"])),\n         Model     = tostring(coalesce(d[\"gen_ai.request.model\"], d[\"gen_ai.response.model\"])),\n         Team      = tostring(d[\"finops.team\"]),\n         CostCenter= tostring(d[\"finops.cost_center\"]),\n         InTok  = tolong(d[\"gen_ai.usage.input_tokens\"]),\n         OutTok = tolong(d[\"gen_ai.usage.output_tokens\"]),\n         Cached = tolong(coalesce(d[\"gen_ai.usage.cache_read.input_tokens\"], d[\"gen_ai.usage.cached_input_tokens\"],\"0\"))\n| where isnotempty(AgentId)\n| extend ModelKey = tolower(replace_regex(Model, @'[\\s\\.\\-_]', ''))\n        | join kind=leftouter hint.remote=left rc on ModelKey\n| extend Cost = ((InTok-Cached)/1000000.0)*InPer1M + (Cached/1000000.0)*CachePer1M + (OutTok/1000000.0)*OutPer1M\n| summarize ['Total cost ($)']=round(sum(Cost),4),\n        ['Input tokens']=sum(InTok), ['Output tokens']=sum(OutTok),\n        Agents=dcount(AgentId), Sessions=dcount(SessionId), Calls=count()",
        "size": 0,
        "title": "Summary",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": [
          "/subscriptions/987426a7-38b5-4ab6-b12b-95f5556b5ddf/resourceGroups/rg-vs-analytics-tju4/providers/microsoft.insights/components/tju4-appinsights-4c1ca4e15b31"
        ],
        "visualization": "table"
      },
      "name": "kpis"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let rc =\n    adx('https://ftkbjccus069d59.centralus.kusto.windows.net/Ingestion').Prices_final_v1_2\n    | where x_SkuMeterCategory == 'Foundry Models' and SkuMeter has 'Tokens'\n    | where SkuMeter !has 'Batch' and SkuMeter !has 'ft' and SkuMeter !has 'training' and SkuMeter !has 'aud' and SkuMeter !has 'rt' and SkuMeter !has 'transcribe' and SkuMeter !has 'tts'\n    | extend P = coalesce(x_EffectiveUnitPrice, ContractedUnitPrice, ListUnitPrice) * 1000000.0 / x_PricingBlockSize\n    | extend Direction = case(SkuMeter has_any('cached','cchd'),'Cached', SkuMeter has_any('outp','output'),'Output', SkuMeter has_any('inp','input','inpt'),'Input','Other')\n    | where Direction != 'Other'\n    | extend ModelKey = tolower(replace_regex(replace_regex(SkuMeter, @'(?i)[\\s\\-]+(cached|cchd|batch|inp|input|inpt|outp|output|glbl|regnl|tokens|dev).*$',''), @'[\\s\\.\\-_]',''))\n    | summarize InPer1M=maxif(P,Direction=='Input'), CachePer1M=maxif(P,Direction=='Cached'), OutPer1M=maxif(P,Direction=='Output') by ModelKey;\ndependencies\n| where timestamp > ago(30d)\n| extend d = parse_json(customDimensions)\n| where isnotempty(d[\"gen_ai.usage.input_tokens\"]) or isnotempty(d[\"gen_ai.usage.output_tokens\"])\n| extend AgentName = tostring(coalesce(d[\"microsoft.gen_ai.main_agent.name\"], d[\"gen_ai.agent.name\"])),\n         AgentId   = tostring(coalesce(d[\"microsoft.gen_ai.main_agent.id\"], d[\"gen_ai.agent.id\"])),\n         SessionId = tostring(coalesce(d[\"microsoft.gen_ai.main_agent.conversation_id\"], d[\"microsoft.session.id\"], d[\"gen_ai.conversation.id\"])),\n         Model     = tostring(coalesce(d[\"gen_ai.request.model\"], d[\"gen_ai.response.model\"])),\n         Team      = tostring(d[\"finops.team\"]),\n         CostCenter= tostring(d[\"finops.cost_center\"]),\n         InTok  = tolong(d[\"gen_ai.usage.input_tokens\"]),\n         OutTok = tolong(d[\"gen_ai.usage.output_tokens\"]),\n         Cached = tolong(coalesce(d[\"gen_ai.usage.cache_read.input_tokens\"], d[\"gen_ai.usage.cached_input_tokens\"],\"0\"))\n| where isnotempty(AgentId)\n| extend ModelKey = tolower(replace_regex(Model, @'[\\s\\.\\-_]', ''))\n        | join kind=leftouter hint.remote=left rc on ModelKey\n| extend Cost = ((InTok-Cached)/1000000.0)*InPer1M + (Cached/1000000.0)*CachePer1M + (OutTok/1000000.0)*OutPer1M\n| summarize Cost=round(sum(Cost),5) by AgentName\n| order by Cost desc",
        "size": 0,
        "title": "Effective cost by agent ($)",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": [
          "/subscriptions/987426a7-38b5-4ab6-b12b-95f5556b5ddf/resourceGroups/rg-vs-analytics-tju4/providers/microsoft.insights/components/tju4-appinsights-4c1ca4e15b31"
        ],
        "visualization": "barchart"
      },
      "name": "cost-by-agent"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let rc =\n    adx('https://ftkbjccus069d59.centralus.kusto.windows.net/Ingestion').Prices_final_v1_2\n    | where x_SkuMeterCategory == 'Foundry Models' and SkuMeter has 'Tokens'\n    | where SkuMeter !has 'Batch' and SkuMeter !has 'ft' and SkuMeter !has 'training' and SkuMeter !has 'aud' and SkuMeter !has 'rt' and SkuMeter !has 'transcribe' and SkuMeter !has 'tts'\n    | extend P = coalesce(x_EffectiveUnitPrice, ContractedUnitPrice, ListUnitPrice) * 1000000.0 / x_PricingBlockSize\n    | extend Direction = case(SkuMeter has_any('cached','cchd'),'Cached', SkuMeter has_any('outp','output'),'Output', SkuMeter has_any('inp','input','inpt'),'Input','Other')\n    | where Direction != 'Other'\n    | extend ModelKey = tolower(replace_regex(replace_regex(SkuMeter, @'(?i)[\\s\\-]+(cached|cchd|batch|inp|input|inpt|outp|output|glbl|regnl|tokens|dev).*$',''), @'[\\s\\.\\-_]',''))\n    | summarize InPer1M=maxif(P,Direction=='Input'), CachePer1M=maxif(P,Direction=='Cached'), OutPer1M=maxif(P,Direction=='Output') by ModelKey;\ndependencies\n| where timestamp > ago(30d)\n| extend d = parse_json(customDimensions)\n| where isnotempty(d[\"gen_ai.usage.input_tokens\"]) or isnotempty(d[\"gen_ai.usage.output_tokens\"])\n| extend AgentName = tostring(coalesce(d[\"microsoft.gen_ai.main_agent.name\"], d[\"gen_ai.agent.name\"])),\n         AgentId   = tostring(coalesce(d[\"microsoft.gen_ai.main_agent.id\"], d[\"gen_ai.agent.id\"])),\n         SessionId = tostring(coalesce(d[\"microsoft.gen_ai.main_agent.conversation_id\"], d[\"microsoft.session.id\"], d[\"gen_ai.conversation.id\"])),\n         Model     = tostring(coalesce(d[\"gen_ai.request.model\"], d[\"gen_ai.response.model\"])),\n         Team      = tostring(d[\"finops.team\"]),\n         CostCenter= tostring(d[\"finops.cost_center\"]),\n         InTok  = tolong(d[\"gen_ai.usage.input_tokens\"]),\n         OutTok = tolong(d[\"gen_ai.usage.output_tokens\"]),\n         Cached = tolong(coalesce(d[\"gen_ai.usage.cache_read.input_tokens\"], d[\"gen_ai.usage.cached_input_tokens\"],\"0\"))\n| where isnotempty(AgentId)\n| extend ModelKey = tolower(replace_regex(Model, @'[\\s\\.\\-_]', ''))\n        | join kind=leftouter hint.remote=left rc on ModelKey\n| extend Cost = ((InTok-Cached)/1000000.0)*InPer1M + (Cached/1000000.0)*CachePer1M + (OutTok/1000000.0)*OutPer1M\n| summarize Cost=round(sum(Cost),5) by CostCenter\n| order by Cost desc",
        "size": 0,
        "title": "Cost by cost center",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": [
          "/subscriptions/987426a7-38b5-4ab6-b12b-95f5556b5ddf/resourceGroups/rg-vs-analytics-tju4/providers/microsoft.insights/components/tju4-appinsights-4c1ca4e15b31"
        ],
        "visualization": "piechart"
      },
      "name": "cost-by-cc"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let rc =\n    adx('https://ftkbjccus069d59.centralus.kusto.windows.net/Ingestion').Prices_final_v1_2\n    | where x_SkuMeterCategory == 'Foundry Models' and SkuMeter has 'Tokens'\n    | where SkuMeter !has 'Batch' and SkuMeter !has 'ft' and SkuMeter !has 'training' and SkuMeter !has 'aud' and SkuMeter !has 'rt' and SkuMeter !has 'transcribe' and SkuMeter !has 'tts'\n    | extend P = coalesce(x_EffectiveUnitPrice, ContractedUnitPrice, ListUnitPrice) * 1000000.0 / x_PricingBlockSize\n    | extend Direction = case(SkuMeter has_any('cached','cchd'),'Cached', SkuMeter has_any('outp','output'),'Output', SkuMeter has_any('inp','input','inpt'),'Input','Other')\n    | where Direction != 'Other'\n    | extend ModelKey = tolower(replace_regex(replace_regex(SkuMeter, @'(?i)[\\s\\-]+(cached|cchd|batch|inp|input|inpt|outp|output|glbl|regnl|tokens|dev).*$',''), @'[\\s\\.\\-_]',''))\n    | summarize InPer1M=maxif(P,Direction=='Input'), CachePer1M=maxif(P,Direction=='Cached'), OutPer1M=maxif(P,Direction=='Output') by ModelKey;\ndependencies\n| where timestamp > ago(30d)\n| extend d = parse_json(customDimensions)\n| where isnotempty(d[\"gen_ai.usage.input_tokens\"]) or isnotempty(d[\"gen_ai.usage.output_tokens\"])\n| extend AgentName = tostring(coalesce(d[\"microsoft.gen_ai.main_agent.name\"], d[\"gen_ai.agent.name\"])),\n         AgentId   = tostring(coalesce(d[\"microsoft.gen_ai.main_agent.id\"], d[\"gen_ai.agent.id\"])),\n         SessionId = tostring(coalesce(d[\"microsoft.gen_ai.main_agent.conversation_id\"], d[\"microsoft.session.id\"], d[\"gen_ai.conversation.id\"])),\n         Model     = tostring(coalesce(d[\"gen_ai.request.model\"], d[\"gen_ai.response.model\"])),\n         Team      = tostring(d[\"finops.team\"]),\n         CostCenter= tostring(d[\"finops.cost_center\"]),\n         InTok  = tolong(d[\"gen_ai.usage.input_tokens\"]),\n         OutTok = tolong(d[\"gen_ai.usage.output_tokens\"]),\n         Cached = tolong(coalesce(d[\"gen_ai.usage.cache_read.input_tokens\"], d[\"gen_ai.usage.cached_input_tokens\"],\"0\"))\n| where isnotempty(AgentId)\n| extend ModelKey = tolower(replace_regex(Model, @'[\\s\\.\\-_]', ''))\n        | join kind=leftouter hint.remote=left rc on ModelKey\n| extend Cost = ((InTok-Cached)/1000000.0)*InPer1M + (Cached/1000000.0)*CachePer1M + (OutTok/1000000.0)*OutPer1M\n| summarize ['Input tokens']=sum(InTok), ['Output tokens']=sum(OutTok) by Model\n| order by ['Output tokens'] desc",
        "size": 0,
        "title": "Tokens by model (input vs output)",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
