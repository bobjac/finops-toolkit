{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "name": "title",
      "content": {
        "json": "## AI agent tokenomics with live hub prices\nMeasured model spans, priced against the verified public-retail meters in your FinOps hub. **Unpriced usage is not free usage.** Estimates exclude infrastructure and telemetry costs. This view does not evaluate answer quality or establish optimization savings.\n\nThe deployed price context is scoped to the seed's model, region, GlobalStandard offer, currency, and seven-day retrieval window. Other models remain unpriced. Refresh the seed and redeploy after its evidence expires. Cached tokens are a subset of total input tokens, not additional input."
      }
    },
    {
      "type": 9,
      "name": "parameters",
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          { "id": "app", "version": "KqlParameterItem/1.0", "name": "ApplicationInsights", "type": 1, "isHiddenWhenLocked": true, "value": "__APP_INSIGHTS_ID__" },
          { "id": "cluster", "version": "KqlParameterItem/1.0", "name": "HubCluster", "type": 1, "isHiddenWhenLocked": true, "value": "__HUB_CLUSTER__" },
          { "id": "database", "version": "KqlParameterItem/1.0", "name": "HubDatabase", "type": 1, "isHiddenWhenLocked": true, "value": "__HUB_DATABASE__" },
          { "id": "prices", "version": "KqlParameterItem/1.0", "name": "PriceContext", "type": 1, "isHiddenWhenLocked": true, "value": "__PRICE_CONTEXT__" },
          {
            "id": "time",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "type": 4,
            "isRequired": true,
            "value": { "durationMs": 86400000 },
            "typeSettings": {
              "selectableValues": [
                { "durationMs": 3600000 },
                { "durationMs": 86400000 },
                { "durationMs": 259200000 },
                { "durationMs": 604800000 }
              ]
            }
          },
          {
            "id": "experiment",
            "version": "KqlParameterItem/1.0",
            "name": "Experiment",
            "type": 2,
            "isRequired": true,
            "value": "all",
            "query": "dependencies\n| where timestamp between (datetime({TimeRange:start}) .. datetime({TimeRange:end}))\n| extend value=tostring(customDimensions['experiment.id'])\n| where isnotempty(value)\n| summarize by value\n| project value, label=value\n| union (print value='all', label='All experiments')",
            "timeContextFromParameter": "TimeRange",
            "queryType": 0,
            "resourceType": "microsoft.insights/components",
            "crossComponentResources": ["{ApplicationInsights}"]
          },
          {
            "id": "baseline",
            "version": "KqlParameterItem/1.0",
            "name": "Baseline",
            "type": 2,
            "isRequired": true,
            "value": "baseline",
            "jsonData": "[{\"value\":\"baseline\",\"label\":\"baseline\"},{\"value\":\"candidate\",\"label\":\"candidate\"}]"
          },
          {
            "id": "candidate",
            "version": "KqlParameterItem/1.0",
            "name": "Candidate",
            "type": 2,
            "isRequired": true,
            "value": "candidate",
            "jsonData": "[{\"value\":\"baseline\",\"label\":\"baseline\"},{\"value\":\"candidate\",\"label\":\"candidate\"}]"
          }
        ],
        "style": "pills"
      }
    },
    {
      "type": 3,
      "name": "summary",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Usage and price coverage",
        "timeContextFromParameter": "TimeRange",
        "query": "__TOKEN_COST_QUERY__\nTokenCosts\n| summarize Calls=count(), Sessions=dcountif(Session, isnotempty(Session)), InputTokens=sum(InputTokens), CachedTokens=sum(CachedTokens), OutputTokens=sum(OutputTokens), UnpricedCalls=countif(PriceStatus != 'priced'), KnownPricedSubtotal=sum(EstimatedCost), DuplicateSpans=sum(Copies - 1)\n| extend CoveragePercent=iff(Calls > 0, 100.0 * (Calls - UnpricedCalls) / Calls, real(null)), EstimatedTotalUSD=iff(Calls > 0 and UnpricedCalls == 0, KnownPricedSubtotal, real(null)), Status=case(Calls == 0, 'No measured calls', UnpricedCalls > 0, 'Incomplete pricing: total unavailable', 'Public retail estimate')",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": ["{ApplicationInsights}"],
        "visualization": "table",
        "size": 0
      }
    },
    {
      "type": 3,
      "name": "breakdown",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Agent and model breakdown",
        "timeContextFromParameter": "TimeRange",
        "query": "__TOKEN_COST_QUERY__\nTokenCosts\n| summarize Calls=count(), InputTokens=sum(InputTokens), CachedTokens=sum(CachedTokens), OutputTokens=sum(OutputTokens), UnpricedCalls=countif(PriceStatus != 'priced'), KnownPricedSubtotal=sum(EstimatedCost) by Agent, Model, Team, CostCenter, Experiment, Variant\n| extend EstimatedTotalUSD=iff(UnpricedCalls == 0, KnownPricedSubtotal, real(null))\n| order by KnownPricedSubtotal desc",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": ["{ApplicationInsights}"],
        "visualization": "table",
        "size": 0
      }
    },
    {
      "type": 3,
      "name": "cost-by-agent",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Estimated model cost by agent (USD, complete groups only)",
        "timeContextFromParameter": "TimeRange",
        "query": "__TOKEN_COST_QUERY__\nTokenCosts\n| summarize KnownPricedSubtotal=sum(EstimatedCost), UnpricedCalls=countif(PriceStatus != 'priced') by Agent\n| extend EstimatedTotalUSD=iff(UnpricedCalls == 0, KnownPricedSubtotal, real(null))\n| project Agent, EstimatedTotalUSD\n| order by EstimatedTotalUSD desc",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": ["{ApplicationInsights}"],
        "visualization": "barchart",
        "size": 0
      }
    },
    {
      "type": 3,
      "name": "cost-by-cc",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Estimated model cost by cost center (USD, complete groups only)",
        "timeContextFromParameter": "TimeRange",
        "query": "__TOKEN_COST_QUERY__\nTokenCosts\n| summarize KnownPricedSubtotal=sum(EstimatedCost), UnpricedCalls=countif(PriceStatus != 'priced') by CostCenter\n| extend EstimatedTotalUSD=iff(UnpricedCalls == 0, KnownPricedSubtotal, real(null))\n| project CostCenter, EstimatedTotalUSD",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": ["{ApplicationInsights}"],
        "visualization": "barchart",
        "size": 0
      }
    },
    {
      "type": 3,
      "name": "tokens-by-model",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Tokens by model (cached input is included in input)",
        "timeContextFromParameter": "TimeRange",
        "query": "__TOKEN_COST_QUERY__\nTokenCosts\n| summarize InputTokens=sum(InputTokens), OutputTokens=sum(OutputTokens) by Model\n| order by OutputTokens desc",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": ["{ApplicationInsights}"],
        "visualization": "barchart",
        "size": 0
      }
    },
    {
      "type": 3,
      "name": "cost-time",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Estimated model cost over time (USD, complete groups only)",
        "timeContextFromParameter": "TimeRange",
        "query": "__TOKEN_COST_QUERY__\nTokenCosts\n| summarize KnownPricedSubtotal=sum(EstimatedCost), UnpricedCalls=countif(PriceStatus != 'priced') by bin(timestamp, 2m), Agent\n| extend EstimatedTotalUSD=iff(UnpricedCalls == 0, KnownPricedSubtotal, real(null))\n| project timestamp, Agent, EstimatedTotalUSD\n| order by timestamp asc",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": ["{ApplicationInsights}"],
        "visualization": "timechart",
        "size": 0
      }
    },
    {
      "type": 3,
      "name": "unpriced",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Unpriced or invalid usage",
        "timeContextFromParameter": "TimeRange",
        "query": "__TOKEN_COST_QUERY__\nTokenCosts\n| where PriceStatus != 'priced'\n| summarize Calls=count(), InputTokens=sum(InputTokens), CachedTokens=sum(CachedTokens), OutputTokens=sum(OutputTokens) by Model, Variant, PriceStatus\n| order by Calls desc",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": ["{ApplicationInsights}"],
        "visualization": "table",
        "size": 0
      }
    },
    {
      "type": 3,
      "name": "comparison",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Baseline and candidate observations (not a savings decision)",
        "timeContextFromParameter": "TimeRange",
        "query": "__TOKEN_COST_QUERY__\nlet Observed=TokenCosts\n| summarize Calls=count(), InputTokens=sum(InputTokens), OutputTokens=sum(OutputTokens), UnpricedCalls=countif(PriceStatus != 'priced'), KnownPricedSubtotal=sum(EstimatedCost), P95ModelLatency=percentile(duration, 95) by Variant;\nprint Variants=dynamic(['{Baseline}', '{Candidate}'])\n| mv-expand Variant=Variants to typeof(string)\n| summarize by Variant\n| join kind=leftouter Observed on Variant\n| project-away Variant1\n| extend Status=case(isnull(Calls), 'No measured calls', UnpricedCalls > 0, 'Incomplete pricing', 'Measured; quality and equivalence not evaluated'), EstimatedTotalUSD=iff(Calls > 0 and UnpricedCalls == 0, KnownPricedSubtotal, real(null)), CostPerModelCallUSD=iff(Calls > 0 and UnpricedCalls == 0, KnownPricedSubtotal / Calls, real(null))",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": ["{ApplicationInsights}"],
        "visualization": "table",
        "size": 0
      }
    },
    {
      "type": 3,
      "name": "provenance",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Price evidence",
        "timeContextFromParameter": "TimeRange",
        "query": "print Context=parse_json(base64_decode_tostring('{PriceContext}'))\n| project Model=tostring(Context.model), Region=tostring(Context.region), DeploymentSku=tostring(Context.deploymentSku), Currency=tostring(Context.currency), RetrievedAt=todatetime(Context.retrievedAt), Source=tostring(Context.sourceUrl), SeedRevision=tostring(Context.seedRevision), Basis='Public retail estimate, not negotiated pricing'",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": ["{ApplicationInsights}"],
        "visualization": "table",
        "size": 0
      }
    }
  ],
  "isLocked": false,
  "fallbackResourceIds": ["__APP_INSIGHTS_ID__"]
}
